# Copy to .env.local — never commit real values.

# Required for Auth / panels / writes
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional — public site URL (sitemap / robots / absolute links)
NEXT_PUBLIC_SITE_URL=https://alvandmarketing.ir

# Optional — Cloudflare R2 public CDN (images)
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://cdn.alvandmarketing.ir
# Optional — R2 upload only (media:migrate-r2 script)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional — Sentry (lite ingest; no-op when unset)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Optional — contact form email notify via Resend (no-op unless BOTH key + to are set)
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=
# Optional From; default: Alvand Contact <onboarding@resend.dev>
CONTACT_NOTIFY_FROM=
